# Optional — GitHub API token used for server-side GitHub data enrichment.
# Without it the site renders from the curated local data snapshot in src/data.
# Create one at https://github.com/settings/tokens (public repo read scope is enough).
GITHUB_TOKEN=

# Public site URL used for canonical links, sitemap and OG metadata.
NEXT_PUBLIC_SITE_URL=https://vaibhav-kumar.dev